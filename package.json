{
  "name": "vscode-tab-stack",
  "displayName": "Tab Stack",
  "description": "A VS Code extension for managing editor tabs",
  "version": "0.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gregflynn/vscode-tab-stack"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tabStack.refreshTabList",
        "title": "Tab Stack: Refresh Tab List",
        "icon": "$(refresh)"
      },
      {
        "command": "tabStack.openTab",
        "title": "Tab Stack: Open Tab"
      },
      {
        "command": "tabStack.closeTab",
        "title": "Tab Stack: Close Tab",
        "icon": "$(close)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "tabStackView",
          "name": "Tab Stack",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tabStack.refreshTabList",
          "when": "view == tabStackView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tabStack.closeTab",
          "when": "view == tabStackView",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "./build-release.sh"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
